# Example environment of tour-server.
# Copy to .env (excluded from git) and fill in real values: cp .env.example .env

# Database password of the PostgreSQL role from config/config.yaml
DB_PASSWORD=change_me

# Secret used to sign JWT tokens; generate one, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Public URL of the frontend; used in links sent by email
FRONTEND_URL=http://localhost:3006

# LiqPay sandbox keys (https://www.liqpay.ua/en/adminbusiness)
LIQPAY_PUBLIC_KEY=sandbox_xxxxxxxx
LIQPAY_PRIVATE_KEY=sandbox_xxxxxxxx
LIQPAY_CALLBACK_URL=https://your-public-host/liqpay/callback

# Optional SMTP account for email notifications; leave empty to disable emails
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
